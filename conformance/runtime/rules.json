{
  "description": "Runtime rules: a stored rule (plus cohorts and memberships) and a context in; value, variant, reason, error code and rule_id out. Rules use the standard_flags_rules column names, stored values are strings, and salts default to the flag key. Each case's rules, cohorts and memberships stand alone. context.units maps unit name to unit key; context.segments lists the segments the context belongs to. Bucket numbers in case names come from bucket_vectors.json's functions.",
  "suite": "runtime",
  "scope": "server",
  "registry": {
    "units": [
      "account"
    ],
    "flags": [
      {
        "kind": "flag",
        "key": "new_checkout",
        "owner": "payments",
        "remove_by": "2027-01-01",
        "final": true,
        "unit": "account"
      },
      {
        "kind": "flag",
        "key": "global_banner",
        "owner": "web",
        "remove_by": "2027-01-01",
        "final": true
      },
      {
        "kind": "kill_switch",
        "key": "ai_assistant",
        "owner": "assistant",
        "unit": "account"
      },
      {
        "kind": "mode",
        "key": "strict_gates",
        "owner": "platform",
        "preset": "sensor",
        "unit": "account"
      },
      {
        "kind": "experiment",
        "key": "home_hero",
        "owner": "growth",
        "variants": [
          "control",
          "savings",
          "privacy"
        ],
        "unit": "account"
      }
    ]
  },
  "cases": [
    {
