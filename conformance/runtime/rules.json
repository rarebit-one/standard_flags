      "flag": "new_checkout",
      "environment": "production",
      "context": {
        "units": {
          "account": "acct_1"
        }
      },
      "rules": [],
      "expected": {
        "value": false,
        "variant": "off",
        "reason": "DEFAULT",
        "rule_id": null,
        "error_code": null
      }
    },
