{
  "description": "legacy_parser: exact reads legacy env: names the way a hand-written ENV[\"X\"] == \"on\" reader did: no trimming or case folding, on only for a legacy_true value, any other value (including a set-but-blank one, unless inverted) pins off, and modes match a value exactly (blank is unset). The canonical STANDARD_FLAGS_<KEY> pin is always strict.",
  "suite": "evaluation",
  "scope": "server",
  "registry": {
    "flags": [
      { "kind": "flag", "key": "purge_inactive", "owner": "platform", "permanent": true,
        "env": "ACME_PURGE_INACTIVE", "legacy_parser": "exact" },
      { "kind": "flag", "key": "bulk_export", "owner": "reporting", "permanent": true,
        "env": "ACME_BULK_EXPORT", "legacy_parser": "exact", "legacy_true": ["on", "enabled"] },
      { "kind": "kill_switch", "key": "ai_assistant", "owner": "assistant",
        "env": "ACME_ASSISTANT_DISABLED", "inverted": true, "legacy_parser": "exact" },
      { "kind": "mode", "key": "strict_gates", "owner": "platform", "preset": "sensor",
        "env": "ACME_STRICT_GATES", "legacy_parser": "exact" },
      { "kind": "flag", "key": "new_reports", "owner": "reporting", "remove_by": "2027-01-01", "final": true,
        "env": "ACME_REPORTS_ENABLED" }
    ]
  },
  "cases": [
    { "name": "exact legacy on turns the flag on", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "on" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "exact legacy true is not on: it pins the flag off", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "true" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "exact legacy matching is case-sensitive", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "ON" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "exact legacy matching does not strip whitespace", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": " on" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "an unrecognised exact legacy value pins off instead of being ignored", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "maybe" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "a set-but-blank exact legacy value pins the flag off", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "  " },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "an empty exact legacy value pins the flag off", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "ACME_PURGE_INACTIVE": "" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "an unset exact legacy name falls through to the default", "flag": "purge_inactive", "environment": "production",
      "env_vars": {},
      "expected": { "value": false, "variant": "off", "reason": "DEFAULT" } },
    { "name": "a blank canonical pin is unset, so the exact legacy name decides", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_PURGE_INACTIVE": " ", "ACME_PURGE_INACTIVE": "on" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "the canonical pin stays strict and case-insensitive", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_PURGE_INACTIVE": " TRUE " },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_PURGE_INACTIVE" } },
    { "name": "the canonical pin wins over an exact legacy name", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_PURGE_INACTIVE": "off", "ACME_PURGE_INACTIVE": "on" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_PURGE_INACTIVE" } },
    { "name": "an unparseable canonical pin falls through to the exact legacy name", "flag": "purge_inactive", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_PURGE_INACTIVE": "maybe", "ACME_PURGE_INACTIVE": "on" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_PURGE_INACTIVE" } },
    { "name": "legacy_true lists every value that means on", "flag": "bulk_export", "environment": "production",
      "env_vars": { "ACME_BULK_EXPORT": "enabled" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_BULK_EXPORT" } },
    { "name": "legacy_true replaces the default on", "flag": "bulk_export", "environment": "production",
      "env_vars": { "ACME_BULK_EXPORT": "yes" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "ACME_BULK_EXPORT" } },
    { "name": "inverted exact legacy on turns the kill switch off", "flag": "ai_assistant", "environment": "production",
      "env_vars": { "ACME_ASSISTANT_DISABLED": "on" },
      "expected": { "value": false, "variant": "off", "reason": "KILL_SWITCH", "source_env_var": "ACME_ASSISTANT_DISABLED" } },
    { "name": "inverted exact legacy true keeps the kill switch on", "flag": "ai_assistant", "environment": "production",
      "env_vars": { "ACME_ASSISTANT_DISABLED": "true" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_ASSISTANT_DISABLED" } },
    { "name": "a blank inverted exact legacy value is unset", "flag": "ai_assistant", "environment": "production",
      "env_vars": { "ACME_ASSISTANT_DISABLED": "" },
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } },
    { "name": "a blank exact legacy mode value is unset", "flag": "strict_gates", "environment": "production",
      "env_vars": { "ACME_STRICT_GATES": " " },
      "expected": { "value": "off", "variant": "off", "reason": "DEFAULT" } },
    { "name": "an exact legacy mode value must equal a mode name", "flag": "strict_gates", "environment": "production",
      "env_vars": { "ACME_STRICT_GATES": "sensor" },
      "expected": { "value": "sensor", "variant": "sensor", "reason": "ENV_PIN", "source_env_var": "ACME_STRICT_GATES" } },
    { "name": "an exact legacy mode value in another case is rejected", "flag": "strict_gates", "environment": "production",
      "env_vars": { "ACME_STRICT_GATES": "Sensor" },
      "expected": { "value": "off", "variant": "off", "reason": "DEFAULT" } },
    { "name": "an exact legacy mode value with whitespace is rejected", "flag": "strict_gates", "environment": "production",
      "env_vars": { "ACME_STRICT_GATES": "on " },
      "expected": { "value": "off", "variant": "off", "reason": "DEFAULT" } },
    { "name": "the canonical mode pin stays case-insensitive", "flag": "strict_gates", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_STRICT_GATES": "Sensor" },
      "expected": { "value": "sensor", "variant": "sensor", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_STRICT_GATES" } },
    { "name": "a legacy name without legacy_parser stays strict", "flag": "new_reports", "environment": "production",
      "env_vars": { "ACME_REPORTS_ENABLED": " Yes " },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "ACME_REPORTS_ENABLED" } }
  ]
}
