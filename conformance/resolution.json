{
  "description": "Code defaults per environment and canonical STANDARD_FLAGS_<KEY> pins for every kind.",
  "suite": "evaluation",
  "scope": "server",
  "registry": {
    "flags": [
      { "kind": "flag", "key": "new_checkout", "owner": "payments", "remove_by": "2027-01-01", "final": true,
        "default": { "staging": true, "production": false } },
      { "kind": "kill_switch", "key": "ai_assistant", "owner": "assistant" },
      { "kind": "mode", "key": "strict_gates", "owner": "platform", "preset": "sensor" },
      { "kind": "mode", "key": "billing_cutover", "owner": "billing", "values": ["off", "shadow", "enforce"],
        "default": { "staging": "shadow" } },
      { "kind": "experiment", "key": "home_hero", "owner": "growth", "variants": ["control", "savings", "privacy"] },
      { "kind": "compat", "key": "legacy_form_auth", "owner": "identity" }
    ]
  },
  "cases": [
    { "name": "flag uses its production default", "flag": "new_checkout", "environment": "production",
      "expected": { "value": false, "variant": "off", "reason": "DEFAULT" } },
    { "name": "flag uses its staging default", "flag": "new_checkout", "environment": "staging",
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } },
    { "name": "flag falls back to off in an environment its default omits", "flag": "new_checkout", "environment": "development",
      "expected": { "value": false, "variant": "off", "reason": "DEFAULT" } },
    { "name": "canonical pin on beats the default", "flag": "new_checkout", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_NEW_CHECKOUT": "on" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_NEW_CHECKOUT" } },
    { "name": "canonical pin is trimmed and case-insensitive", "flag": "new_checkout", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_NEW_CHECKOUT": "  YES " },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_NEW_CHECKOUT" } },
    { "name": "canonical pin 0 turns a flag off", "flag": "new_checkout", "environment": "staging",
      "env_vars": { "STANDARD_FLAGS_NEW_CHECKOUT": "0" },
      "expected": { "value": false, "variant": "off", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_NEW_CHECKOUT" } },
    { "name": "unparseable canonical pin is ignored", "flag": "new_checkout", "environment": "staging",
      "env_vars": { "STANDARD_FLAGS_NEW_CHECKOUT": "enabled" },
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } },
    { "name": "blank canonical pin counts as unset", "flag": "new_checkout", "environment": "staging",
      "env_vars": { "STANDARD_FLAGS_NEW_CHECKOUT": "   " },
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } },
    { "name": "kill switch is on by default", "flag": "ai_assistant", "environment": "production",
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } },
    { "name": "kill switch pinned off reports KILL_SWITCH", "flag": "ai_assistant", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_AI_ASSISTANT": "off" },
      "expected": { "value": false, "variant": "off", "reason": "KILL_SWITCH", "source_env_var": "STANDARD_FLAGS_AI_ASSISTANT" } },
    { "name": "kill switch pinned on reports ENV_PIN", "flag": "ai_assistant", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_AI_ASSISTANT": "true" },
      "expected": { "value": true, "variant": "on", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_AI_ASSISTANT" } },
    { "name": "mode defaults to its first value", "flag": "strict_gates", "environment": "production",
      "expected": { "value": "off", "variant": "off", "reason": "DEFAULT" } },
    { "name": "mode pin accepts a declared value case-insensitively", "flag": "strict_gates", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_STRICT_GATES": "Sensor" },
      "expected": { "value": "sensor", "variant": "sensor", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_STRICT_GATES" } },
    { "name": "mode pin rejects boolean words", "flag": "strict_gates", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_STRICT_GATES": "true" },
      "expected": { "value": "off", "variant": "off", "reason": "DEFAULT" } },
    { "name": "mode with explicit values uses its per-environment default", "flag": "billing_cutover", "environment": "staging",
      "expected": { "value": "shadow", "variant": "shadow", "reason": "DEFAULT" } },
    { "name": "experiment resolves to its first variant", "flag": "home_hero", "environment": "production",
      "expected": { "value": "control", "variant": "control", "reason": "DEFAULT" } },
    { "name": "experiment pin selects a declared variant", "flag": "home_hero", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_HOME_HERO": "savings" },
      "expected": { "value": "savings", "variant": "savings", "reason": "ENV_PIN", "source_env_var": "STANDARD_FLAGS_HOME_HERO" } },
    { "name": "experiment pin rejects an undeclared variant", "flag": "home_hero", "environment": "production",
      "env_vars": { "STANDARD_FLAGS_HOME_HERO": "treatment" },
      "expected": { "value": "control", "variant": "control", "reason": "DEFAULT" } },
    { "name": "compat flag is on until removed", "flag": "legacy_form_auth", "environment": "production",
      "expected": { "value": true, "variant": "on", "reason": "DEFAULT" } }
  ]
}
