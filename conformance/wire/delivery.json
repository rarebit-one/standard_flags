{
  "description": "Delivery: a registry, a context (units, client) and stored rules in; the OFREP entries a client audience is told, and their ETag, out. Entries are ordered by key (the wire name). Every alias of a flag carries the same evaluation; a flag with min_client is withheld from a client on a listed platform below the minimum, on a listed platform with an unknown version, or with no platform; a tombstone's static wires are served (reason STATIC) through `until` (a UTC date) and to clients below `until_clients`, and to clients of unknown version or of a platform it doesn't list. An errored flag is an OFREP evaluationFailure. The etag is the SHA-256 (lowercase hex) of the RFC 8785 (JCS) canonical JSON (keys sorted, no whitespace, strings as raw UTF-8 with only the escapes JCS requires; no numbers occur) of {\"audience\": <audience>, \"flags\": <entries>}. etag_same_as / etag_differs_from name earlier cases. Servers produce these; clients can use each expected body as a golden OFREP payload. No case's payload may contain any string in never_on_wire.",
  "suite": "delivery",
  "scope": "wire",
  "environment": "production",
  "today": "2026-12-01",
  "never_on_wire": [
    "internal_only",
    "new_checkout",
    "strict_gates",
    "home_hero",
    "broken_flag",
    "STANDARD_FLAGS_",
    "ACME_AI_DISABLED",
    "acct_a",
    "acct_b",
    "acct_c",
    "rule_id",
    "source_env_var",
    "allow",
    "fallthrough",
    "kiosk_theme",
    "banner_v1"
  ],
  "registry": {
    "units": [
      "account"
    ],
    "flags": [
      {
        "kind": "kill_switch",
        "key": "ai",
        "owner": "assistant",
        "env": [
          "ACME_AI_DISABLED"
        ],
        "inverted": true,
        "expose": {
          "mobile": [
            "chat_enabled",
            "insights_enabled"
          ],
          "web": "ai"
        }
      },
      {
        "kind": "flag",
        "key": "new_checkout",
        "owner": "payments",
        "remove_by": "2027-01-01",
        "final": true,
        "unit": "account",
        "expose": {
          "mobile": "checkoutV2"
        },
        "min_client": {
          "android": "0.4.0",
          "ios": "0.4.0"
        }
      },
      {
        "kind": "mode",
        "key": "strict_gates",
        "owner": "platform",
        "preset": "sensor",
        "expose": {
          "mobile": "gates"
        }
      },
      {
        "kind": "experiment",
        "key": "home_hero",
        "owner": "growth",
        "variants": [
          "control",
          "savings"
        ],
        "unit": "account",
        "expose": {
          "mobile": "homeHero"
        }
      },
      {
        "kind": "flag",
        "key": "broken_flag",
        "owner": "platform",
        "remove_by": "2027-01-01",
        "final": true,
        "expose": {
          "mobile": "brokenFlag"
        }
      },
      {
        "kind": "flag",
        "key": "internal_only",
        "owner": "platform",
        "remove_by": "2027-01-01",
        "final": true,
        "unit": "account"
      },
      {
        "kind": "experiment",
        "key": "kiosk_theme",
        "owner": "growth",
        "variants": [
          "contrôle",
          "café"
        ],
        "expose": {
          "kiosk": "theme"
        }
      }
    ],
    "tombstones": [
      {
        "key": "chat_v1",
        "removed": "2026-11-01",
        "serve": {
          "mobile": {
            "chat_v1": false,
            "chatMode": "legacy"
          }
        },
        "until": "2027-03-01",
        "until_clients": {
          "android": "0.6.0"
        }
      },
      {
        "key": "old_banner",
        "removed": "2026-01-01"
      },
      {
        "key": "banner_v1",
        "removed": "2026-11-01",
        "serve": {
          "kiosk": {
            "bannerText": "Grüße   \u0001 \" / \\  – ok"
          }
        },
        "until": "2027-03-01"
      }
    ]
  },
