# Generated by `bin/rails g standard_flags:admin`. Yours to change.
#
# Pages read through StandardFlags::MCP, so `config.authorize` decides who
# may read ("flags:read") and unit keys stay masked. Every change goes
# through StandardFlags::Operations: authorised ("flags:write", or
# "flags:ramp" for ramps), refused for ENV-pinned flags, validated, audited,
# and checked against the revision the page was showing.
#
# Every request runs as the signed-in user (ACTOR_METHOD), never as
# config.actor_resolver: with nobody signed in it is denied before any tool
# runs. Unit keys are posted as `unit_keys`, which Rails' default
# filter_parameters (`_key`) keeps out of the request log.
class <%= controller_class %> < <%= base_controller %>
  BASE_PATH = <%= mount_path.inspect %>.freeze
  ACTOR_METHOD = :<%= actor_method %>

  before_action :require_standard_flags_actor

  def index
    flags = tool("list_flags")
    return refuse(flags) if flags["error"]

    render inertia: "standard_flags/index", props: { base_path: BASE_PATH, flags: flags, flash: flash.to_hash }
  end

  def show
    flag = tool("get_flag", "key" => params[:id])
    return refuse(flag) if flag["error"]

    render inertia: "standard_flags/show", props: {
      base_path: BASE_PATH, flag: flag, members: members(flag), flash: flash.to_hash,
      audit: (StandardFlags::AuditTrail.new.entries(flag["key"]) if StandardFlags::AuditTrail.available?)
    }
  end

  def start = change(StandardFlags::Operations::Start)
  def pause = change(StandardFlags::Operations::Pause)
  def stop = change(StandardFlags::Operations::Stop, serve: params[:serve])
  def ramp = change(StandardFlags::Operations::Ramp) { { bps: Integer(params[:bps].to_s, 10), **optional(:value) } }
  def set_value = change(StandardFlags::Operations::SetValue, value: params[:value].presence)
  def add_members = change(StandardFlags::Operations::AddMembers, keys: member_keys, **optional(:value))
  def remove_members = change(StandardFlags::Operations::RemoveMembers, keys: member_keys)

  private

  # Who the page runs as: the signed-in user, or nil.
  def standard_flags_actor
    return @standard_flags_actor if defined?(@standard_flags_actor)

    @standard_flags_actor = respond_to?(ACTOR_METHOD, true) ? __send__(ACTOR_METHOD) : nil
  end

  def require_standard_flags_actor
    standard_flags_deny if standard_flags_actor.nil?
  end

  # Nobody is signed in. Redirect to your sign-in page here if you prefer.
  def standard_flags_deny
    head :unauthorized
  end

  def tool(name, arguments = {})
    StandardFlags::MCP.tool(name).call(arguments, actor: standard_flags_actor)
  end

  # One page of the flag's members, keys masked; nil when it can have none.
  def members(flag)
    return unless flag["unit"] && flag["runtime_rules"]

    page = tool("list_members", "key" => flag["key"], "offset" => [ params[:members_offset].to_i, 0 ].max)
    page unless page["error"]
  end

  # Runs the operation as the signed-in user, then redirects back with a
  # flash. A block builds arguments that can fail to parse.
  def change(operation, **args)
    args = yield if block_given?
    result = operation.call(params[:id], actor: standard_flags_actor, reason: params[:reason].to_s,
                                         expected_revision: params[:expected_revision].presence&.to_i, **args)
    if result.success?
      flash[:notice] = "#{operation.name.demodulize}: done (revision #{result.value[:revision]})"
    else
      flash[:alert] = "#{operation.name.demodulize} refused (#{result.code}): #{result.errors.join('; ')}"
    end
    redirect_to standard_flags_flag_path(params[:id])
  rescue ArgumentError => e
    flash[:alert] = e.message
    redirect_to standard_flags_flag_path(params[:id])
  end

  def optional(*names)
    names.filter_map { |name| [ name, params[name] ] if params[name].present? }.to_h
  end

  def member_keys
    params[:unit_keys].to_s.split(/[\s,]+/).compact_blank
  end

  def refuse(result)
    status = { "unauthorized" => :forbidden, "unknown_flag" => :not_found, "tombstoned_flag" => :not_found }
    render plain: result.dig("error", "message"), status: status.fetch(result.dig("error", "code"), :unprocessable_entity)
  end
end
