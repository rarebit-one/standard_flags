// Generated by `bin/rails g standard_flags:admin`. Yours to restyle.
// Types come from `bin/rails standard_flags:typescript`.
import type { FormEvent, ReactNode } from "react";
import { Link, useForm } from "@inertiajs/react";
import type { FlagAuditEntry, FlagDetail, FlagMemberPage } from "<%= types_import %>";

interface Flash {
  readonly notice?: string;
  readonly alert?: string;
}

interface Props {
  readonly base_path: string;
  readonly flag: FlagDetail;
  readonly members: FlagMemberPage | null;
  readonly audit: ReadonlyArray<FlagAuditEntry> | null;
  readonly flash: Flash;
}

type Field =
  | { readonly name: string; readonly label: string; readonly kind: "text" | "number" | "keys" }
  | { readonly name: string; readonly label: string; readonly kind: "select"; readonly options: ReadonlyArray<string> };

interface OperationFormProps {
  readonly action: string;
  readonly title: string;
  readonly revision: number | null;
  readonly fields?: ReadonlyArray<Field>;
}

// One operation: its fields, a required reason, and the revision the page
// showed, so a change made meanwhile is refused rather than overwritten.
function OperationForm({ action, title, revision, fields = [] }: OperationFormProps) {
  const initial: Record<string, string> = { reason: "", expected_revision: revision === null ? "" : String(revision) };
  fields.forEach((field) => {
    initial[field.name] = "";
  });
  const { data, setData, post, processing } = useForm<Record<string, string>>(initial);

  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    post(action);
  }

  return (
    <form onSubmit={submit}>
      <fieldset>
        <legend>{title}</legend>
        {fields.map((field) => (
          <p key={field.name}>
            <label>
              {field.label}{" "}
              {field.kind === "select" ? (
                <select value={data[field.name]} onChange={(e) => setData(field.name, e.target.value)}>
                  <option value="">(none)</option>
                  {field.options.map((option) => (
                    <option key={option} value={option}>
                      {option}
                    </option>
                  ))}
                </select>
              ) : field.kind === "keys" ? (
                <textarea value={data[field.name]} onChange={(e) => setData(field.name, e.target.value)} />
              ) : (
                <input
                  type={field.kind}
                  value={data[field.name]}
                  onChange={(e) => setData(field.name, e.target.value)}
                />
              )}
            </label>
          </p>
        ))}
        <p>
          <label>
            Reason (audited){" "}
            <input type="text" required value={data.reason} onChange={(e) => setData("reason", e.target.value)} />
          </label>
        </p>
        <button type="submit" disabled={processing}>
          {title}
        </button>
      </fieldset>
    </form>
  );
}

function Row({ term, children }: { readonly term: string; readonly children: ReactNode }) {
  return (
    <>
      <dt>{term}</dt>
      <dd>{children}</dd>
    </>
  );
}

export default function StandardFlagsShow({ base_path, flag, members, audit, flash }: Props) {
  const action = (operation: string) => `${base_path}/${flag.key}/${operation}`;
  const revision = flag.rule?.revision ?? null;
  const values = flag.values;
  const rule = flag.rule;
  const editable = flag.runtime_rules && flag.pinned === null;

  return (
    <main>
      <p>
        <Link href={base_path}>All flags</Link>
      </p>
      <h1>{flag.key}</h1>
      {flash.notice && <p role="status">{flash.notice}</p>}
      {flash.alert && <p role="alert">{flash.alert}</p>}
      {flag.pinned && (
        <p role="status">
          <strong>{flag.pinned.label}</strong>: read-only here. Unset the variable to change it from this page.
        </p>
      )}

      <section>
        <h2>Declaration</h2>
        <dl>
          <Row term="Kind">{flag.kind}</Row>
          <Row term="Owner">{flag.owner}</Row>
          {flag.description && <Row term="Description">{flag.description}</Row>}
          <Row term="Unit">{flag.unit ?? "none"}</Row>
          <Row term="Values">{values.join(", ")}</Row>
          <Row term="Code default">{flag.default}</Row>
        </dl>
      </section>

      <section>
        <h2>Value here</h2>
        <dl>
          <Row term="Value">
            <code>{flag.evaluation.value ?? "none"}</code>
          </Row>
          <Row term="Reason">{flag.evaluation.reason}</Row>
          <Row term="Decided by">{flag.evaluation.source}</Row>
          {flag.evaluation.rule_id && <Row term="Rule part">{flag.evaluation.rule_id}</Row>}
        </dl>
      </section>

      <section>
        <h2>Runtime rule</h2>
        {!flag.runtime_rules && <p>Runtime rules are off.</p>}
        {flag.runtime_rules && rule === null && <p>No rule yet: the code default serves.</p>}
        {rule && (
          <dl>
            <Row term="Status">{rule.status}</Row>
            <Row term="Revision">{rule.revision}</Row>
            <Row term="Percentage">
              {rule.percentage_bps === null ? "none" : `${rule.percentage_bps / 100}%`}
              {rule.rollout_value && ` → ${rule.rollout_value}`}
            </Row>
            <Row term="Variants">
              {Object.entries(rule.variant_weights)
                .map(([variant, weight]) => `${variant} ${weight / 100}%`)
                .join(", ") || "none"}
            </Row>
            <Row term="Fallthrough">{rule.fallthrough_value ?? "none"}</Row>
            {rule.status === "stopped" && <Row term="Serving">{rule.stop_value}</Row>}
            <Row term="Cohorts">
              {rule.cohorts.map((attachment) => `${attachment.cohort} → ${attachment.value}`).join(", ") || "none"}
            </Row>
            <Row term="Members">{rule.member_count}</Row>
          </dl>
        )}
      </section>

      {members && (
        <section>
          <h2>Members ({members.total})</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">Unit key</th>
                <th scope="col">Unit</th>
                <th scope="col">Value</th>
                <th scope="col">Expires</th>
              </tr>
            </thead>
            <tbody>
              {members.members.map((member, index) => (
                <tr key={`${members.offset + index}`}>
                  <td>
                    <code>{member.unit_key}</code>
                  </td>
                  <td>{member.unit}</td>
                  <td>{member.value}</td>
                  <td>{member.expired ? "expired" : (member.expires_at ?? "never")}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <nav aria-label="Member pages">
            {members.offset > 0 && (
              <Link href={`${base_path}/${flag.key}?members_offset=${Math.max(members.offset - members.limit, 0)}`}>
                Previous
              </Link>
            )}{" "}
            {members.next_offset !== null && (
              <Link href={`${base_path}/${flag.key}?members_offset=${members.next_offset}`}>Next</Link>
            )}
          </nav>
        </section>
      )}

      {editable && (
        <section>
          <h2>Change</h2>
          <OperationForm action={action("start")} title="Start" revision={revision} />
          <OperationForm action={action("pause")} title="Pause" revision={revision} />
          <OperationForm
            action={action("ramp")}
            title="Ramp"
            revision={revision}
            fields={[
              { name: "bps", label: "Basis points (0-10000)", kind: "number" },
              { name: "value", label: "Rollout value", kind: "select", options: values },
            ]}
          />
          <OperationForm
            action={action("set_value")}
            title="Set fallthrough value"
            revision={revision}
            fields={[{ name: "value", label: "Value (none clears it)", kind: "select", options: values }]}
          />
          <OperationForm
            action={action("stop")}
            title="Stop"
            revision={revision}
            fields={[{ name: "serve", label: "Serve to everyone", kind: "select", options: values }]}
          />
          {flag.unit && (
            <>
              <OperationForm
                action={action("add_members")}
                title="Add members"
                revision={revision}
                fields={[
                  { name: "unit_keys", label: "Unit keys (comma or newline separated)", kind: "keys" },
                  { name: "value", label: "Value", kind: "select", options: values },
                ]}
              />
              <OperationForm
                action={action("remove_members")}
                title="Remove members"
                revision={revision}
                fields={[{ name: "unit_keys", label: "Unit keys (comma or newline separated)", kind: "keys" }]}
              />
            </>
          )}
        </section>
      )}

      {audit && (
        <section>
          <h2>Recent changes</h2>
          {audit.length === 0 ? (
            <p>None recorded.</p>
          ) : (
            <ol>
              {audit.map((entry, index) => (
                <li key={`${entry.occurred_at}-${index}`}>
                  <time dateTime={entry.occurred_at ?? undefined}>{entry.occurred_at}</time> {entry.event} by{" "}
                  {entry.actor ?? "unknown"}
                  {entry.revision !== null && ` (revision ${entry.revision})`}: {entry.reason}
                </li>
              ))}
            </ol>
          )}
        </section>
      )}
    </main>
  );
}
