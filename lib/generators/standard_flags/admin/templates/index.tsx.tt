// Generated by `bin/rails g standard_flags:admin`. Yours to restyle.
// Types come from `bin/rails standard_flags:typescript`.
import { Link } from "@inertiajs/react";
import type { FlagList, FlagSummary } from "<%= types_import %>";

interface Flash {
  readonly notice?: string;
  readonly alert?: string;
}

interface Props {
  readonly base_path: string;
  readonly flags: FlagList;
  readonly flash: Flash;
}

function ruleText(flag: FlagSummary): string {
  if (flag.rule === null) return "none";
  const percentage = flag.rule.percentage_bps === null ? "" : `, ${flag.rule.percentage_bps / 100}%`;
  return `${flag.rule.status}${percentage}`;
}

export default function StandardFlagsIndex({ base_path, flags, flash }: Props) {
  return (
    <main>
      <h1>Feature flags</h1>
      {flash.notice && <p role="status">{flash.notice}</p>}
      {flash.alert && <p role="alert">{flash.alert}</p>}
      <p>
        Runtime rules are {flags.runtime_rules ? "on" : "off"}
        {flags.store_revision !== null && ` (revision ${flags.store_revision})`}.
      </p>
      <table>
        <thead>
          <tr>
            <th scope="col">Flag</th>
            <th scope="col">Kind</th>
            <th scope="col">Owner</th>
            <th scope="col">Value</th>
            <th scope="col">Decided by</th>
            <th scope="col">Rule</th>
          </tr>
        </thead>
        <tbody>
          {flags.flags.map((flag) => (
            <tr key={flag.key}>
              <th scope="row">
                <Link href={`${base_path}/${flag.key}`}>{flag.key}</Link>
                {flag.description && <p>{flag.description}</p>}
              </th>
              <td>{flag.kind}</td>
              <td>{flag.owner}</td>
              <td>
                <code>{flag.value ?? "none"}</code>
              </td>
              <td>{flag.pinned ? <strong>{flag.pinned.label}</strong> : `${flag.source} (${flag.reason})`}</td>
              <td>{ruleText(flag)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </main>
  );
}
