{
  "description": "Client conditions in runtime rules: version ranges in the neutral syntax (space-separated comparators, all of which must hold, with || alternatives), SemVer prerelease ordering and shorthand versions, RubyGems ranges stored before the neutral syntax, and build-number ranges. Every rule rolls out to 100% with an off fallthrough, so a met condition reads SPLIT/percentage and an unmet one TARGETING_MATCH/fallthrough. context.client holds the platform, version and build as a client sends them.",
  "registry": {
    "units": [
      "account"
    ],
    "flags": [
      {
        "kind": "flag",
        "key": "new_checkout",
        "owner": "payments",
        "remove_by": "2027-01-01",
        "final": true,
        "unit": "account"
      }
    ]
  },
  "cases": [
    {
      "name": "a neutral range is met",
      "flag": "new_checkout",
      "environment": "production",
      "context": {
        "units": {
          "account": "acct_1"
        },
        "client": {
          "platform": "android",
          "version": "1.4.0"
        }
      },
      "rules": [
        {
          "key": "new_checkout",
          "status": "running",
          "percentage_bps": 10000,
          "fallthrough_value": "off",
          "conditions": {
            "versions": {
              "android": ">=1.4.0 <2.0.0"
            }
          }
        }
      ],
      "expected": {
        "value": true,
        "variant": "on",
        "reason": "SPLIT",
        "rule_id": "percentage",
        "error_code": null
      }
    },
    {
