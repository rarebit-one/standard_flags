{
  "scope": "server",
  "description": "Server only (Ruby): how version ranges stored by 0.2.x in RubyGems syntax keep evaluating, exactly as Gem::Requirement does. translations give the neutral form a RubyGems requirement is stored as when written through SetConditions (null when the neutral syntax cannot hold it, in which case it is stored as given and evaluated by RubyGems). cases give a stored range and a client version, matched or not; a client version outside SemVer is read by RubyGems against any range RubyGems can read. Clients never evaluate these.",
  "translations": [
    {
      "range": "~> 1.4",
      "neutral": ">=1.4.0 <2.0.0-0"
    },
    {
      "range": "~> 1.4.2",
      "neutral": ">=1.4.2 <1.5.0-0"
    },
    {
      "range": "~> 1",
      "neutral": ">=1.0.0 <2.0.0-0"
    },
    {
      "range": ">= 1.4, < 2",
      "neutral": ">=1.4.0 <2.0.0"
    },
    {
      "range": "!= 1.5",
      "neutral": "<1.5.0 || >1.5.0"
    },
    {
      "range": "1.4.0",
      "neutral": "=1.4.0"
    },
    {
      "range": "~> 1.4.0.beta",
      "neutral": ">=1.4.0-beta <1.5.0-0"
    },
    {
      "range": ">= 1.4.0.1",
      "neutral": null
    },
    {
      "range": "~> 1.4.2.1",
      "neutral": null
    }
  ],
  "cases": [
    {
      "range": "~> 1.4",
      "version": "1.9.9",
      "matched": true
    },
    {
      "range": "~> 1.4",
      "version": "2.0.0",
      "matched": false
    },
    {
      "range": "~> 1.4",
      "version": "2.0.0-beta.1",
      "matched": false
    },
    {
      "range": "~> 1.4",
      "version": "2.0.0-0",
      "matched": false
    },
    {
      "range": "~> 1.4",
      "version": "1.4.0-rc.1",
      "matched": false
    },
    {
      "range": "~> 1.4.2",
      "version": "1.4.9",
      "matched": true
    },
    {
      "range": "~> 1.4.2",
      "version": "1.5.0-beta",
      "matched": false
    },
    {
      "range": "~> 1.4.2",
      "version": "1.4.2-beta",
      "matched": false
    },
    {
      "range": ">= 1.4, < 2",
      "version": "1.9.9-rc.1",
      "matched": true
    },
    {
      "range": ">= 1.4, < 2",
      "version": "2.0.0-beta.1",
      "matched": true
    },
    {
      "range": "!= 1.5",
      "version": "1.5.0",
      "matched": false
    },
    {
      "range": "!= 1.5",
      "version": "1.5.1",
      "matched": true
    },
    {
      "range": ">= 1.4.0",
      "version": "1.4.0.1",
      "matched": true
    },
    {
      "range": ">= 1.4.0",
      "version": "1.4.0.beta",
      "matched": false
    },
    {
      "range": ">= 1.4.0",
      "version": "01.4.0",
      "matched": true
    },
    {
      "range": ">= 1.4.0.1",
      "version": "1.4.0.2",
      "matched": true
    },
    {
      "range": ">= 1.4.0.1",
      "version": "1.4.0",
      "matched": false
    },
    {
      "range": "~> 1.4.2.1",
      "version": "1.4.2.9",
      "matched": true
    },
    {
      "range": "~> 1.4.2.1",
      "version": "1.4.3",
      "matched": false
    },
    {
      "range": "!= 1.0, != 1.1, != 1.2, != 1.3, != 1.4, != 1.5, != 1.6",
      "version": "1.7.0",
      "matched": true
    },
    {
      "range": "!= 1.0, != 1.1, != 1.2, != 1.3, != 1.4, != 1.5, != 1.6",
      "version": "1.3",
      "matched": false
    }
  ]
}
